# Isabella Backend Environment Configuration

# LongCat API Key (required)
LONGCAT_API_KEY=your_api_key_here

# Emotion Detection Configuration (optional)
# Enable or disable emotion detection (default: true)
EMOTION_ENABLE=true

# Minimum confidence threshold for emotions (default: 0.35)
# Lower values = more emotions detected (more sensitive)
# Higher values = fewer emotions detected (less sensitive)
EMOTION_THRESHOLD=0.35

# Optional: Limit number of emotions returned (default: no limit)
# Example: EMOTION_TOP_K=3 returns top 3 emotions only
# EMOTION_TOP_K=

# MongoDB Connection (optional, defaults to localhost)
# MONGODB_URI=mongodb://127.0.0.1:27017/isabella
